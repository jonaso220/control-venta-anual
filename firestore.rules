rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasAppAccess() {
      return request.auth != null
        && request.auth.token.get('appAccess', false) == true;
    }

    function isOwner(uid) {
      return hasAppAccess() && request.auth.uid == uid;
    }

    function hasExactFields(data, required, optional) {
      return data.keys().hasAll(required)
        && data.keys().hasOnly(required.concat(optional));
    }

    function isNumber(value) {
      return value is int || value is float;
    }

    function isBoundedNumber(value, minimum, maximum) {
      return isNumber(value) && value >= minimum && value <= maximum;
    }

    function isBoundedInteger(value, minimum, maximum) {
      return value is int && value >= minimum && value <= maximum;
    }

    function isValidYear(year) {
      return isBoundedInteger(year, 2000, 2099);
    }

    function isValidYearMonthId(documentId, year, month) {
      return isValidYear(year)
        && isBoundedInteger(month, 1, 12)
        && (
          (month < 10 && documentId == string(year) + '-0' + string(month))
          || (month >= 10 && documentId == string(year) + '-' + string(month))
        );
    }

    function isValidCategory(category) {
      return category in [
        'impuestos',
        'prestamos',
        'seguros',
        'sueldos',
        'vehiculo',
        'otros'
      ];
    }

    function isValidRequiredText(value, maximumLength) {
      return value is string
        && value.trim().size() > 0
        && value.size() <= maximumLength;
    }

    function isValidOptionalText(data, field, maximumLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maximumLength);
    }

    function hasCurrentTimestamp(data, field) {
      return field in data
        && data[field] is timestamp
        && data[field] == request.time;
    }

    function isValidHistoricalTimestamp(data, field) {
      return field in data
        && data[field] is timestamp
        && data[field] >= timestamp.date(2000, 1, 1)
        && data[field] <= request.time;
    }

    function hasValidOptionalHistoricalTimestamp(data, field) {
      return !(field in data) || isValidHistoricalTimestamp(data, field);
    }

    function isValidPriceMap(prices) {
      return prices is map
        && hasExactFields(
          prices,
          ['sifones', 'litros6', 'litros12', 'litros20'],
          []
        )
        && isBoundedNumber(prices.sifones, 0, 1000000000)
        && isBoundedNumber(prices.litros6, 0, 1000000000)
        && isBoundedNumber(prices.litros12, 0, 1000000000)
        && isBoundedNumber(prices.litros20, 0, 1000000000);
    }

    function validCalendarDate(value) {
      return value is string && value.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10])) != null;
    }

    function pricePair(margins, prices) {
      return isValidPriceMap(margins) && isValidPriceMap(prices)
        && margins.sifones <= prices.sifones && margins.litros6 <= prices.litros6
        && margins.litros12 <= prices.litros12 && margins.litros20 <= prices.litros20;
    }

    function tariffAt(list, i, year) {
      return list.size() <= i || (
        hasExactFields(list[i], ['effectiveFrom', 'margins', 'publicPrices'], [])
        && validCalendarDate(list[i].effectiveFrom)
        && list[i].effectiveFrom[0:4] == year
        && pricePair(list[i].margins, list[i].publicPrices)
        && (i == 0 || list[i-1].effectiveFrom < list[i].effectiveFrom)
      );
    }

    function newTariffDate(old, tariff) {
      let list = old;
      return (list.size() <= 0 || (list[0].effectiveFrom != tariff.effectiveFrom && (list.size() <= 1 || (list[1].effectiveFrom != tariff.effectiveFrom && (list.size() <= 2 || (list[2].effectiveFrom != tariff.effectiveFrom && (list.size() <= 3 || (list[3].effectiveFrom != tariff.effectiveFrom && (list.size() <= 4 || (list[4].effectiveFrom != tariff.effectiveFrom && (list.size() <= 5 || (list[5].effectiveFrom != tariff.effectiveFrom && (list.size() <= 6 || (list[6].effectiveFrom != tariff.effectiveFrom && (list.size() <= 7 || (list[7].effectiveFrom != tariff.effectiveFrom && (list.size() <= 8 || (list[8].effectiveFrom != tariff.effectiveFrom && (list.size() <= 9 || (list[9].effectiveFrom != tariff.effectiveFrom && (list.size() <= 10 || (list[10].effectiveFrom != tariff.effectiveFrom && (list.size() <= 11 || (list[11].effectiveFrom != tariff.effectiveFrom && (list.size() <= 12 || (list[12].effectiveFrom != tariff.effectiveFrom && (list.size() <= 13 || (list[13].effectiveFrom != tariff.effectiveFrom && (list.size() <= 14 || (list[14].effectiveFrom != tariff.effectiveFrom && (list.size() <= 15 || (list[15].effectiveFrom != tariff.effectiveFrom && (list.size() <= 16 || (list[16].effectiveFrom != tariff.effectiveFrom && (list.size() <= 17 || (list[17].effectiveFrom != tariff.effectiveFrom && (list.size() <= 18 || (list[18].effectiveFrom != tariff.effectiveFrom && (list.size() <= 19 || (list[19].effectiveFrom != tariff.effectiveFrom && (list.size() <= 20 || (list[20].effectiveFrom != tariff.effectiveFrom && (list.size() <= 21 || (list[21].effectiveFrom != tariff.effectiveFrom && (list.size() <= 22 || (list[22].effectiveFrom != tariff.effectiveFrom && (list.size() <= 23 || (list[23].effectiveFrom != tariff.effectiveFrom && true))))))))))))))))))))))))))))))))))))))))))))))));
    }
    function initialTariffs(list, year) {
      return list is list && list.size() <= 1 && tariffAt(list, 0, year);
    }
    function updatedTariffs(next, old, year) {
      let added = next.removeAll(old);
      return next == old || (next.size() == old.size() + 1 && next.size() <= 24
        && next.hasAll(old) && added.size() == 1 && tariffAt(added, 0, year)
        && newTariffDate(old, added[0]));
    }

    function allocationAt(rows, i) {
      let row = rows[i];
      let prefix = rows[0].from[0:7];
      return row.keys().hasOnly(['from', 'to', 'tariffFrom', 'sifones', 'litros6', 'litros12', 'litros20', 'marginSnapshot', 'publicPriceSnapshot'])
        && row.from.matches('^' + prefix + '-(0[1-9]|[12][0-9]|3[01])$')
        && row.to.matches('^' + prefix + '-(0[1-9]|[12][0-9]|3[01])$')
        && row.tariffFrom <= row.from && row.from <= row.to
        && (i == 0 ? row.from == prefix + '-01' : int(row.from[8:10]) == int(rows[i-1].to[8:10]) + 1)
        && row.sifones is int && row.sifones >= 0
        && row.litros6 is int && row.litros6 >= 0
        && row.litros12 is int && row.litros12 >= 0
        && row.litros20 is int && row.litros20 >= 0;
    }
    function validAllocations(data) {
      let rows = data.allocations;
      let zero = {'sifones': 0, 'litros6': 0, 'litros12': 0, 'litros20': 0};
      let a = rows[0];
      let b = rows.size() > 1 ? rows[1] : zero;
      return rows is list && rows.size() > 0 && rows.size() <= 2
        && data.sifones == a.sifones + b.sifones
        && data.litros6 == a.litros6 + b.litros6
        && data.litros12 == a.litros12 + b.litros12
        && data.litros20 == a.litros20 + b.litros20
        && rows[0].from == string(data.year) + '-' + (data.month < 10 ? '0' : '') + string(data.month) + '-01'
        && allocationAt(rows, 0)
        && (rows.size() < 2 || allocationAt(rows, 1))
        && timestamp.date(data.year, data.month, int(rows[rows.size()-1].to[8:10])) + duration.value(1, 'd')
          == (data.month == 12 ? timestamp.date(data.year + 1, 1, 1) : timestamp.date(data.year, data.month + 1, 1));
    }
    function preservedAllocationRates(rows, old) {
      return rows.size() == old.size()
        && rows[0].diff(old[0]).affectedKeys().hasOnly(['sifones','litros6','litros12','litros20'])
        && (rows.size() < 2 || rows[1].diff(old[1]).affectedKeys().hasOnly(['sifones','litros6','litros12','litros20']));
    }
    function tariffMatches(row, tariffs) {
      return tariffs.hasAny([{'effectiveFrom': row.tariffFrom, 'margins': row.marginSnapshot, 'publicPrices': row.publicPriceSnapshot}]);
    }
    function allocationTariffsMatch(data, uid) {
      let tariffs = getAfter(/databases/$(database)/documents/users/$(uid)/config/$("prices-" + string(data.year))).data.get('tariffs', []);
      let rows = data.allocations;
      return tariffMatches(rows[0], tariffs)
        && (rows.size() < 2 || tariffMatches(rows[1], tariffs));
    }
    function sameSaleUnits(a, b) {
      return a.sifones == b.sifones && a.litros6 == b.litros6 && a.litros12 == b.litros12 && a.litros20 == b.litros20;
    }

    function isValidSales(data, saleId, updating) {
      return hasExactFields(
          data,
          [
            'year',
            'month',
            'sifones',
            'litros6',
            'litros12',
            'litros20',
            'marginSnapshot',
            'updatedAt'
          ],
          ['createdAt', 'allocations']
        )
        && (!('allocations' in data) || validAllocations(data))
        && isValidYearMonthId(saleId, data.year, data.month)
        && ('allocations' in data
          ? (data.sifones <= 1000000000 && data.litros6 <= 1000000000 && data.litros12 <= 1000000000 && data.litros20 <= 1000000000)
          : (isBoundedInteger(data.sifones, 0, 1000000000) && isBoundedInteger(data.litros6, 0, 1000000000)
            && isBoundedInteger(data.litros12, 0, 1000000000) && isBoundedInteger(data.litros20, 0, 1000000000)))
        && (updating || isValidPriceMap(data.marginSnapshot))
        && hasCurrentTimestamp(data, 'updatedAt')
        && hasValidOptionalHistoricalTimestamp(data, 'createdAt');
    }

    function isValidExpense(data) {
      return hasExactFields(
          data,
          ['name', 'amount', 'dueDate', 'category', 'isActive', 'createdAt', 'updatedAt'],
          ['notes', 'historyVersion', 'latestEffectiveFrom']
        )
        && isValidRequiredText(data.name, 120)
        && isBoundedNumber(data.amount, 0.01, 1000000000000)
        && data.dueDate is string
        && data.dueDate.size() <= 80
        && isValidCategory(data.category)
        && data.isActive is bool
        && isValidOptionalText(data, 'notes', 1000)
        && (
          (!('historyVersion' in data) && !('latestEffectiveFrom' in data))
          || (
            data.historyVersion == 1
            && data.latestEffectiveFrom is string
            && data.latestEffectiveFrom.matches('^(20)[0-9]{2}-(0[1-9]|1[0-2])$')
          )
        )
        && isValidHistoricalTimestamp(data, 'createdAt')
        && hasCurrentTimestamp(data, 'updatedAt');
    }

    function isValidFixedExpenseVersion(data, versionId) {
      return hasExactFields(
          data,
          [
            'expenseId',
            'effectiveFrom',
            'name',
            'amount',
            'dueDate',
            'category',
            'isActive',
            'createdAt',
            'updatedAt'
          ],
          ['notes']
        )
        && data.expenseId is string
        && data.expenseId.size() > 0
        && data.expenseId.size() <= 1400
        && data.effectiveFrom is string
        && data.effectiveFrom.matches('^(20)[0-9]{2}-(0[1-9]|1[0-2])$')
        && versionId == data.expenseId + '__' + data.effectiveFrom
        && isValidRequiredText(data.name, 120)
        && isBoundedNumber(data.amount, 0.01, 1000000000000)
        && data.dueDate is string
        && data.dueDate.size() <= 80
        && isValidCategory(data.category)
        && data.isActive is bool
        && isValidOptionalText(data, 'notes', 1000)
        && isValidHistoricalTimestamp(data, 'createdAt')
        && hasCurrentTimestamp(data, 'updatedAt');
    }

    function sameFixedExpenseSnapshot(expense, version) {
      return expense.name == version.name
        && expense.amount == version.amount
        && expense.dueDate == version.dueDate
        && expense.category == version.category
        && expense.isActive == version.isActive
        && expense.get('notes', null) == version.get('notes', null);
    }

    function latestFixedExpenseVersionMatches(uid, expenseId, expense) {
      let versionId = expenseId + '__' + expense.latestEffectiveFrom;
      let version = getAfter(
        /databases/$(database)/documents/users/$(uid)/fixedExpenseVersions/$(versionId)
      ).data;
      return sameFixedExpenseSnapshot(expense, version);
    }

    function currentFixedExpenseVersionMatchesParent(uid, version) {
      let expense = getAfter(
        /databases/$(database)/documents/users/$(uid)/expenses/$(version.expenseId)
      ).data;
      return expense.historyVersion == 1
        && expense.latestEffectiveFrom == version.effectiveFrom
        && sameFixedExpenseSnapshot(expense, version);
    }

    function fixedExpenseVersionHasValidParent(uid, version) {
      let expense = getAfter(
        /databases/$(database)/documents/users/$(uid)/expenses/$(version.expenseId)
      ).data;
      return expense.historyVersion == 1
        && version.effectiveFrom <= expense.latestEffectiveFrom
        && (
          version.effectiveFrom < expense.latestEffectiveFrom
          || sameFixedExpenseSnapshot(expense, version)
        );
    }

    function isCurrentYearMonth(value) {
      return value == string(request.time.year()) + '-'
        + (request.time.month() < 10 ? '0' : '')
        + string(request.time.month());
    }

    function isValidVariableExpense(data) {
      return hasExactFields(
          data,
          ['date', 'description', 'amount', 'category', 'createdAt', 'updatedAt'],
          ['notes']
        )
        && data.date is string
        && data.date.matches(
          '^(20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'
        )
        && isValidRequiredText(data.description, 200)
        && isBoundedNumber(data.amount, 0.01, 1000000000000)
        && isValidCategory(data.category)
        && isValidOptionalText(data, 'notes', 1000)
        && isValidHistoricalTimestamp(data, 'createdAt')
        && hasCurrentTimestamp(data, 'updatedAt');
    }

    function isValidPrices(data, configId) {
      return configId.matches('^prices-(20)[0-9]{2}$')
        && hasExactFields(
          data,
          ['sifones', 'litros6', 'litros12', 'litros20', 'updatedAt'],
          ['tariffs']
        )
        && isBoundedNumber(data.sifones, 0, 1000000000)
        && isBoundedNumber(data.litros6, 0, 1000000000)
        && isBoundedNumber(data.litros12, 0, 1000000000)
        && isBoundedNumber(data.litros20, 0, 1000000000)
        && hasCurrentTimestamp(data, 'updatedAt');
    }

    function isValidPriceHistory(data) {
      return hasExactFields(
          data,
          ['year', 'sifones', 'litros6', 'litros12', 'litros20', 'changedAt'],
          []
        )
        && isValidYear(data.year)
        && isBoundedNumber(data.sifones, 0, 1000000000)
        && isBoundedNumber(data.litros6, 0, 1000000000)
        && isBoundedNumber(data.litros12, 0, 1000000000)
        && isBoundedNumber(data.litros20, 0, 1000000000)
        && isValidHistoricalTimestamp(data, 'changedAt');
    }

    function isValidOptionalGoal(data, field) {
      return !(field in data)
        || isBoundedNumber(data[field], 0, 1000000000000);
    }

    function isValidOptionalUnitGoal(data, field) {
      return !(field in data)
        || isBoundedInteger(data[field], 0, 1000000000);
    }

    function isValidGoal(data, goalId) {
      return hasExactFields(
          data,
          ['year', 'month', 'updatedAt'],
          [
            'targetMargin',
            'targetIncome',
            'targetSifones',
            'targetLitros6',
            'targetLitros12',
            'targetLitros20',
            'createdAt'
          ]
        )
        && isValidYearMonthId(goalId, data.year, data.month)
        && data.keys().hasAny([
          'targetMargin',
          'targetIncome',
          'targetSifones',
          'targetLitros6',
          'targetLitros12',
          'targetLitros20'
        ])
        && isValidOptionalGoal(data, 'targetMargin')
        && isValidOptionalGoal(data, 'targetIncome')
        && isValidOptionalUnitGoal(data, 'targetSifones')
        && isValidOptionalUnitGoal(data, 'targetLitros6')
        && isValidOptionalUnitGoal(data, 'targetLitros12')
        && isValidOptionalUnitGoal(data, 'targetLitros20')
        && hasCurrentTimestamp(data, 'updatedAt')
        && hasValidOptionalHistoricalTimestamp(data, 'createdAt');
    }

    match /users/{uid}/sales/{saleId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidSales(request.resource.data, saleId, false)
        && (!('allocations' in request.resource.data) || allocationTariffsMatch(request.resource.data, uid))
        && hasValidOptionalHistoricalTimestamp(request.resource.data, 'createdAt');
      allow update: if isOwner(uid)
        && isValidSales(request.resource.data, saleId, true)
        && (!('allocations' in resource.data) || 'allocations' in request.resource.data)
        && (!('allocations' in request.resource.data)
          || preservedAllocationRates(request.resource.data.allocations, resource.data.get('allocations', []))
          || (sameSaleUnits(request.resource.data, resource.data) && allocationTariffsMatch(request.resource.data, uid)))
        && request.resource.data.get('createdAt', null)
          == resource.data.get('createdAt', null)
        && (('marginSnapshot' in resource.data)
          ? request.resource.data.marginSnapshot == resource.data.marginSnapshot
          : isValidPriceMap(request.resource.data.marginSnapshot));
      // A sale is cleared by saving zero units. Deletion would allow an old
      // margin snapshot to be discarded and the document recreated.
      allow delete: if false;
    }

    match /users/{uid}/expenses/{expenseId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidExpense(request.resource.data)
        && request.resource.data.historyVersion == 1
        && latestFixedExpenseVersionMatches(uid, expenseId, request.resource.data);
      allow update: if isOwner(uid)
        && isValidExpense(request.resource.data)
        && request.resource.data.historyVersion == 1
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          !('latestEffectiveFrom' in resource.data)
          || request.resource.data.latestEffectiveFrom >= resource.data.latestEffectiveFrom
        )
        && latestFixedExpenseVersionMatches(uid, expenseId, request.resource.data);
      allow delete: if false;
    }

    match /users/{uid}/fixedExpenseVersions/{versionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidFixedExpenseVersion(request.resource.data, versionId)
        && fixedExpenseVersionHasValidParent(uid, request.resource.data);
      allow update: if isOwner(uid)
        && isValidFixedExpenseVersion(request.resource.data, versionId)
        && request.resource.data.expenseId == resource.data.expenseId
        && request.resource.data.effectiveFrom == resource.data.effectiveFrom
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            isCurrentYearMonth(request.resource.data.effectiveFrom)
            && currentFixedExpenseVersionMatchesParent(uid, request.resource.data)
          )
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        );
      allow delete: if false;
    }

    match /users/{uid}/variableExpenses/{expenseId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidVariableExpense(request.resource.data);
      allow update: if isOwner(uid)
        && isValidVariableExpense(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/config/{configId} {
      // Collection reads are required by backup/restore verification. Writes
      // remain restricted to the validated prices-YYYY document shape below.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidPrices(request.resource.data, configId)
        && initialTariffs(request.resource.data.get('tariffs', []), configId[7:11]);
      allow update: if isOwner(uid) && isValidPrices(request.resource.data, configId)
        && updatedTariffs(request.resource.data.get('tariffs', []), resource.data.get('tariffs', []), configId[7:11]);
      allow delete: if isOwner(uid) && configId.matches('^prices-(20)[0-9]{2}$') && resource.data.get('tariffs', []).size() == 0;
    }

    match /users/{uid}/priceHistory/{historyId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidPriceHistory(request.resource.data);
      allow update: if isOwner(uid)
        && isValidPriceHistory(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().size() == 0;
      allow delete: if false;
    }

    match /users/{uid}/goals/{goalId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidGoal(request.resource.data, goalId)
        && hasValidOptionalHistoricalTimestamp(request.resource.data, 'createdAt');
      allow update: if isOwner(uid)
        && isValidGoal(request.resource.data, goalId)
        && request.resource.data.get('createdAt', null)
          == resource.data.get('createdAt', null);
      allow delete: if isOwner(uid);
    }

    // Closed by default: parent user documents, unknown collections and any
    // future nested paths require an explicit rule before clients can use them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
