VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# App Check es opcional hasta registrar la app web en Firebase.
VITE_FIREBASE_APPCHECK_ENTERPRISE_SITE_KEY=
# Solo para .env.local durante desarrollo; nunca habilitar en produccion.
VITE_FIREBASE_APPCHECK_DEBUG=false

# Lista opcional, separada por comas, punto y coma o espacios.
# Si ambas listas estan vacias y REQUIRE es false, se conserva el acceso actual.
VITE_AUTH_ALLOWED_EMAILS=
VITE_AUTH_ALLOWED_UIDS=
VITE_AUTH_REQUIRE_ALLOWLIST=false
# Activar en el cliente solo despues de otorgar appAccess a los usuarios validos.
VITE_AUTH_REQUIRE_APP_ACCESS_CLAIM=false
